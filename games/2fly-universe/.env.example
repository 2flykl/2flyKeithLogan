# Universe environment variables
# Copy this file to .env and fill in values to enable production persistence.

# Supabase (optional — leave blank to use demo/localStorage adapter)
# Get these from your Supabase project settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Universe base path on your hosting (no trailing slash needed by Vite, but check docs)
# For GitHub Pages sub-path hosting:
# VITE_BASE=/games/2fly-universe/
